{
  "name": "salonflow-frontend",
  "private": true,
  "description": "Tailwind CSS build for SalonFlow's Django templates",
  "scripts": {
    "build": "tailwindcss -i static/src/app.css -o static/css/app.css --minify",
    "dev": "tailwindcss -i static/src/app.css -o static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
