# Copy to .env and adjust. Never commit the real .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only:
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=True

# Hostnames "db" / "redis" work inside docker compose; use localhost when running locally.
DATABASE_URL=postgres://salonflow:salonflow@db:5432/salonflow
REDIS_URL=redis://redis:6379/0

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SalonFlow <noreply@localhost>

# SMS: console backend prints messages (dev). For Twilio use
# apps.notifications.sms.backends.twilio.TwilioBackend and fill TWILIO_*.
SMS_BACKEND=apps.notifications.sms.backends.console.ConsoleBackend
SMS_SENDER=SalonFlow
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# How often Celery beat looks for due reminders.
REMINDER_DISPATCH_INTERVAL_SECONDS=300

LLM_API_KEY=
