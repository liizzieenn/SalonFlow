# Production .env for docker-compose.prod.yml (copy to .env on the server).
# Never commit the real file.

# Public hostname; DNS A/AAAA records must point at the server.
DOMAIN=salonflow.example.com
# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

DJANGO_SECRET_KEY=generate-with:python -c "import secrets; print(secrets.token_urlsafe(50))"
POSTGRES_PASSWORD=generate-a-long-random-password

# Email (SMTP) for confirmations and reminders.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SalonFlow <noreply@salonflow.example.com>

# SMS: console backend logs messages; use Twilio for real delivery.
SMS_BACKEND=apps.notifications.sms.backends.console.ConsoleBackend
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AI assistant (fake providers need no keys).
ASSISTANT_LLM_BACKEND=apps.assistant.providers.fake.FakeLLM
ASSISTANT_EMBEDDING_BACKEND=apps.assistant.providers.fake.FakeEmbeddings
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Demo salon logins created by `manage.py seed_demo`.
DEMO_PASSWORD=salonflow-demo

GUNICORN_WORKERS=3
